      "range": {
        "min": 0.0,
        "max": 1.0,
        "step": 0.01
      }
    },
    {
      "code": "EntitySoundBlockOcclusionLowPassPerBlock",
      "type": "float",
      "default": 0.8,
      "clientSide": true,
      "ingui": "Low-pass per occluding block",
      "comment": "Per-block low-pass multiplier for occlusion.",
      "range": {
        "min": 0.0,
        "max": 1.0,
        "step": 0.01
      }
    },
    {
      "code": "EntitySoundBlockOcclusionMinVolumeFactor",
      "type": "float",
      "default": 0.08,
      "clientSide": true,
      "ingui": "Minimum occluded volume",
      "comment": "Clamp floor for occluded volume.",
      "range": {
        "min": 0.0,
        "max": 1.0,
        "step": 0.01
      }
    },
    {
      "code": "EntitySoundBlockOcclusionMinLowPass",
      "type": "float",
      "default": 0.04,
      "clientSide": true,
      "ingui": "Minimum occluded low-pass",
      "comment": "Clamp floor for occluded low-pass filtering.",
      "range": {
        "min": 0.0,
        "max": 1.0,
        "step": 0.01
      }
    },
    {
      "code": "ShowEntitySoundOcclusionDebugRays",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Show occlusion debug rays",
      "comment": "Render sound occlusion debug rays when debug tools are enabled."
